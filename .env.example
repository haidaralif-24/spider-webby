# Copy to `.env.local`. Never commit real values.
#
# P0 needs NONE of these. P0 renders from local seed data in `content/` and has
# no database dependency at all (AGENTS.md §5). They become required in P1.

# ---- Supabase — the system of record: Postgres, Auth, RLS, Edge Functions ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary — image bytes only ----
# The cloud name appears in every delivery URL, so it is public by design.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# Used ONLY to sign uploads inside a Server Action (AGENTS.md §4.4).
# Never expose this to the client, and never use an unsigned upload preset.
CLOUDINARY_API_SECRET=
